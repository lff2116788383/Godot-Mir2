## 玩家动作区间判定
static func is_player_motion(t: int) -> bool:
	return t >= MOTION_BEGIN and t < MOTION_END


static func is_monster_motion(t: int) -> bool:
	return t >= MOTION_MON_BEGIN and t < MOTION_MON_END


static func is_npc_motion(t: int) -> bool:
	return t >= MOTION_NPC_BEGIN and t < MOTION_NPC_END
